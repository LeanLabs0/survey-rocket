# Project URL: https://<project-ref>.supabase.co  (ref is on Settings → General)
SUPABASE_URL=

# Settings → API Keys → Publishable and secret API keys
# (legacy anon / service_role still work; new keys are preferred)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Pooler URI from the green Connect button (Transaction / port 6543).
# Prefer aws-0-<region>.pooler.supabase.com — db.<ref>.supabase.co often fails DNS locally.
DATABASE_URL=

PUBLIC_SITE_URL=https://beta.surveyrocket.ai
PUBLIC_APP_URL=https://beta.surveyrocket.ai
FACTOR8_API_URL=https://factor8-agent-sdk.fly.dev/api/v1/public/survey-rocket
FACTOR8_SERVICE_KEY=
# From HubSpot → Development → Projects → Survey Rocket → Auth
HUBSPOT_APP_CLIENT_ID=
HUBSPOT_APP_CLIENT_SECRET=
# Production callback. The HubSpot app also lists localhost:4321; local dev uses that automatically.
HUBSPOT_APP_REDIRECT_URI=
HUBSPOT_TOKEN_ENCRYPTION_KEY=
IP_SALT=
CRON_SECRET=

# Local test accounts (edward+admin@lean-labs.com superadmin, edward@lean-labs.com client)
DEV_LOGIN_PASSWORD=
