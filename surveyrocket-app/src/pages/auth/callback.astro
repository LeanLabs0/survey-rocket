---
import type { EmailOtpType } from "@supabase/supabase-js";
import Base from "../../layouts/Base.astro";
import { isSetupAuthType } from "../../lib/auth-handoff";
import { passwordSetupPath } from "../../lib/auth-messages";
import { isPendingInviteEmail } from "../../lib/invite";
import { persistSessionCookies, plainAuthClient, safeNextPath, supabaseFromCookies } from "../../lib/supabase";
import { touchSession } from "../../lib/sessions";

const next = safeNextPath(Astro.url.searchParams.get("next"));
const code = Astro.url.searchParams.get("code");
const token = Astro.url.searchParams.get("token_hash") || Astro.url.searchParams.get("token");
const type = (Astro.url.searchParams.get("type") as EmailOtpType | null) || (token ? "invite" : null);
const auth = plainAuthClient();
let established = false;
let sessionEmail: string | null = null;

async function keep(session: { user?: { id?: string; email?: string | null } | null } | null) {
  if (!session) return false;
  persistSessionCookies(Astro.cookies, session as Parameters<typeof persistSessionCookies>[1]);
  sessionEmail = session.user?.email ?? sessionEmail;
  if (session.user?.id) {
    await touchSession(session.user.id, Astro.cookies, Astro.request).catch(() => null);
  }
  return true;
}

if (code) {
  const { data } = await auth.auth.exchangeCodeForSession(code);
  established = await keep(data.session);
}

if (token && type) {
  const { data } = await auth.auth.verifyOtp({ token_hash: token, type });
  if (data.session) {
    established = await keep(data.session);
  } else {
    const supabase = supabaseFromCookies(Astro.cookies, Astro.request);
    const verified = await supabase.auth.verifyOtp({ token_hash: token, type });
    established = await keep(verified.data.session) || established;
  }
}

const pending = sessionEmail ? await isPendingInviteEmail(sessionEmail).catch(() => false) : false;
const setup = isSetupAuthType(type) || next === passwordSetupPath() || pending;
if (established) {
  return Astro.redirect(setup ? passwordSetupPath() : next);
}

const dest = setup ? passwordSetupPath() : next;
---
<Base title="Opening your invite · Survey Rocket" bodyClass="login-page">
  <header class="login-top">
    <a class="login-wordmark" href="/">
      <img src="/assets/landing/survey-rocket.svg" width="180" height="45" alt="Survey Rocket" />
    </a>
  </header>
  <main class="login-main">
    <div class="login-card">
      <h1>Opening your invite</h1>
      <p id="status" class="lede">One moment…</p>
      <p class="back"><a href="/login">Back to sign in</a></p>
    </div>
  </main>
</Base>
<style>
.login-page{min-height:100vh;background:var(--page)}
.login-top{display:flex;align-items:center;height:64px;padding:0 24px;border-bottom:1px solid var(--line)}
.login-wordmark{display:inline-flex;align-items:center;text-decoration:none}
.login-wordmark img{display:block;height:36px;width:auto}
.login-main{display:flex;justify-content:center;padding:56px 20px 80px}
.login-card{width:100%;max-width:420px;background:var(--card);box-shadow:var(--inset);border-radius:var(--r-lg);padding:32px 28px 28px}
.login-card h1{font-size:28px;letter-spacing:-.03em;margin:0 0 8px}
.lede{margin:0 0 22px;color:var(--tx-2);font-size:14px;line-height:1.5}
.back{margin:22px 0 0;font-size:13px}
.back a{color:var(--tx-2)}
</style>
<script define:vars={{ dest }}>
  (async () => {
    const status = document.getElementById("status");
    const hash = new URLSearchParams(location.hash.replace(/^#/, ""));
    const access_token = hash.get("access_token");
    const refresh_token = hash.get("refresh_token");
    const hashType = hash.get("type") || "";
    if (hash.get("error") || hash.get("error_description")) {
      if (status) status.textContent = "This invite link is no longer valid. Ask your admin to resend it, then open the new email.";
      return;
    }
    if (!access_token || !refresh_token) {
      if (status) status.textContent = "This invite link is no longer valid. Ask your admin to resend it, then open the new email.";
      return;
    }
    const res = await fetch("/api/auth/session", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ access_token, refresh_token }),
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      if (status) status.textContent = "This invite link expired. Ask your admin to resend it, then open the new email.";
      return;
    }
    const setup = hashType === "invite" || hashType === "recovery" || hashType === "signup" || dest === "/auth/set-password" || body.needsPassword;
    location.replace(setup ? "/auth/set-password" : dest);
  })();
</script>
