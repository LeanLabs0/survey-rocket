---
import Base from "../../layouts/Base.astro";

const error = Astro.url.searchParams.get("error");
const signedIn = Boolean(Astro.locals.user);
---
<Base title="Choose a password · Survey Rocket" bodyClass="login-page">
  <header class="login-top">
    <a class="login-wordmark" href="/">
      <img src="/assets/landing/survey-rocket.svg" width="180" height="45" alt="Survey Rocket" />
    </a>
  </header>
  <main class="login-main">
    <div class="login-card">
      <h1>Choose your password</h1>
      <p class="lede">Your workspace admin created this account. Set a password you will use to sign in.</p>
      {error && <p class="login-msg err">{error}</p>}
      {signedIn ? (
        <form class="login-panel" method="post" action="/api/auth/set-password">
          <label for="new-password">New password</label>
          <input id="new-password" type="password" name="password" required minlength="8" autocomplete="new-password" />
          <label for="confirm-password">Confirm password</label>
          <input id="confirm-password" type="password" name="confirm" required minlength="8" autocomplete="new-password" />
          <button class="btn primary login-submit" type="submit">Save password</button>
        </form>
      ) : (
        <p class="login-msg err">Open the link from your email to choose a password. The link expires, so request a new one from sign-in if you need it.</p>
      )}
      <p class="back"><a href="/login">Back to sign in</a></p>
    </div>
  </main>
</Base>
<style>
.login-page{min-height:100vh;background:var(--page)}
.login-top{display:flex;align-items:center;height:64px;padding:0 24px;border-bottom:1px solid var(--line)}
.login-wordmark{display:inline-flex;align-items:center;text-decoration:none}
.login-wordmark img{display:block;height:36px;width:auto}
.login-main{display:flex;justify-content:center;padding:56px 20px 80px}
.login-card{width:100%;max-width:420px;background:var(--card);box-shadow:var(--inset);border-radius:var(--r-lg);padding:32px 28px 28px}
.login-card h1{font-size:28px;letter-spacing:-.03em;margin:0 0 8px}
.lede{margin:0 0 22px;color:var(--tx-2);font-size:14px;line-height:1.5}
.login-msg{font-size:14px;margin:0 0 14px;line-height:1.45}
.login-msg.err{color:var(--red)}
.login-panel label{display:block;font-size:12px;color:var(--tx-3);text-transform:uppercase;letter-spacing:.07em;margin:12px 0 6px}
.login-panel label:first-child{margin-top:0}
.login-panel input{width:100%;background:var(--page);box-shadow:var(--inset);border:0;border-radius:var(--r-md);padding:12px 14px;color:var(--tx);font-size:15px}
.login-submit{width:100%;margin-top:18px}
.back{margin:22px 0 0;font-size:13px}
.back a{color:var(--tx-2)}
</style>
