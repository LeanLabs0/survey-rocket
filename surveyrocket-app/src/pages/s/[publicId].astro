---
import Base from "../../layouts/Base.astro";
import NotFoundApp from "../../components/NotFoundApp.astro";
import "../../styles/styles-survey-intro.css";
import { db } from "../../lib/db";
import { clients, surveyPublications, surveys } from "../../lib/schema";
import { desc, eq } from "drizzle-orm";
import { resolveChatIntro, resolveSurveyBrand } from "../../lib/brand";
import { resolveWelcomeCopy } from "../../lib/definition";
import { slugify } from "../../lib/ids";
import { getConnection } from "../../lib/hubspot/tokens";
import { ensureClientSignInForm } from "../../lib/hubspot/provision";

function hasQuestions(definition: unknown) {
  if (!definition || typeof definition !== "object") return false;
  const questions = (definition as { questions?: unknown }).questions;
  return Array.isArray(questions) && questions.length > 0;
}

function absHttpUrl(value: unknown) {
  if (typeof value !== "string") return "";
  const t = value.trim();
  if (!t) return "";
  if (/^https?:\/\//i.test(t)) return t;
  if (/^[a-z0-9][a-z0-9.-]+\.[a-z]{2,}([/:?#].*)?$/i.test(t)) return `https://${t}`;
  return "";
}

function visitCtaLabel(name: string) {
  const words = name.trim().split(/\s+/).filter(Boolean);
  const keep = words.filter((w) => !/^(the|of|and|a|for)$/i.test(w));
  if (keep.length >= 3) return `Visit ${keep.map((w) => w.charAt(0).toUpperCase()).join("")}`;
  return `Visit ${name}`;
}

const publicId = Astro.params.publicId!;
const [found] = await db.select().from(surveys).where(eq(surveys.publicId, publicId)).limit(1);
const sv = found && !found.deletedAt ? found : null;
const [client] = sv ? await db.select().from(clients).where(eq(clients.id, sv.clientId)).limit(1) : [null];
const [pub] = sv
  ? await db.select().from(surveyPublications).where(eq(surveyPublications.surveyId, sv.id)).orderBy(desc(surveyPublications.version)).limit(1)
  : [null];
const definition = pub?.definition || sv?.definition || null;
const missing = !sv || sv.status === "Draft" || !hasQuestions(definition);
if (missing) {
  Astro.response.status = 404;
}
const clientName = client?.name || "Survey Rocket";
const reputationRocketUrl = `https://reputationrocket.ai/${slugify(clientName)}`;
const brandRecord = client?.brand && typeof client.brand === "object" ? (client.brand as Record<string, unknown>) : {};
const clientWebsite =
  absHttpUrl(brandRecord.website) ||
  absHttpUrl(brandRecord.siteUrl) ||
  (client?.slug === "fatherhood" ? "https://www.fatherhood.org" : "");
const visitLabel = visitCtaLabel(clientName);
const brand = resolveSurveyBrand(client?.brand, {
  logoUrl: client?.logoUrl,
  clientName,
  surveyName: sv?.name || null,
});
const chatIntro = resolveChatIntro(
  definition && typeof definition === "object" && "settings" in definition
    ? (definition as { settings?: { chat_lede?: unknown; chat_sub?: unknown } }).settings
    : null,
);
const welcome = resolveWelcomeCopy(definition);
const workspaceLogo = client?.logoUrl || null;
const clientKey = client?.slug || client?.id || "";
let hubspotForm: { portalId: string; formId: string } | null = null;
if (!missing && client) {
  const conn = await getConnection(client.id);
  if (conn?.status === "connected" && conn.portalId && conn.signinFormId) {
    hubspotForm = { portalId: conn.portalId, formId: conn.signinFormId };
  } else if (conn?.status === "connected") {
    try {
      const ensured = await ensureClientSignInForm(client.id);
      if (ensured?.portalId && ensured.formId) {
        hubspotForm = { portalId: ensured.portalId, formId: ensured.formId };
      }
    } catch (err) {
      console.error("signin form", err);
    }
  }
}
---
{missing ? (
  <NotFoundApp kind="survey" />
) : (
<Base title={sv?.name || "Survey"} bodyClass="rs-intro-page">
  <Fragment slot="head">
    {brand.googleFontsHref ? <link rel="stylesheet" href={brand.googleFontsHref} /> : null}
    <style set:html={`html,body.rs-intro-page{${brand.cssVars}}`}></style>
  </Fragment>
  <div class="rs-page" style={brand.cssVars} data-bot-avatar={brand.botAvatar}>
    <div class="rs-glow" aria-hidden="true"></div>
    <div class="rs-main">
      <a class="rs-intro-brand" href="/">
        <img class:list={[{ "rs-workspace-logo": !!workspaceLogo }]} src={workspaceLogo || brand.markUrl} width={workspaceLogo ? undefined : 48} height={workspaceLogo ? undefined : 55} alt={clientName}>
        {workspaceLogo ? null : (
          <span><b>Survey</b> <i>Rocket</i></span>
        )}
      </a>

      <div class="rs-steps" id="steps" style={`display:${definition ? "flex" : "none"}`}>
        <div class="rs-step on" data-step="0">
          <span class="dot" aria-hidden="true"><span class="ico"></span><span class="check"></span></span>
          <span class="idx">Step 1</span>
          <span class="nm">Welcome</span>
          <span class="pill">In Progress</span>
        </div>
        <span class="rs-step-line partial" aria-hidden="true"></span>
        <div class="rs-step" data-step="1">
          <span class="dot" aria-hidden="true"><span class="ico"></span><span class="check"></span></span>
          <span class="idx">Step 2</span>
          <span class="nm">Quick Chat</span>
          <span class="pill">Pending</span>
        </div>
        <span class="rs-step-line" aria-hidden="true"></span>
        <div class="rs-step" data-step="2">
          <span class="dot" aria-hidden="true"><span class="ico"></span><span class="check"></span></span>
          <span class="idx">Step 3</span>
          <span class="nm">Your Review</span>
          <span class="pill">Pending</span>
        </div>
        <span class="rs-step-line" aria-hidden="true"></span>
        <div class="rs-step" data-step="3">
          <span class="dot" aria-hidden="true"><span class="ico"></span><span class="check"></span></span>
          <span class="idx">Step 4</span>
          <span class="nm">Post It</span>
          <span class="pill">Pending</span>
        </div>
      </div>

      <div class="rs-welcome" id="welcome" style={`display:${definition ? "flex" : "none"}`}>
        {welcome.title
          ? <h1 class="rs-welcome-custom">{welcome.title}</h1>
          : <h1>Ready to <span class="em">share your results</span> with {clientName}?</h1>}
        <p class="rs-sub" id="g-meta">{welcome.intro}</p>
        <div class="rs-heads">
          <span class="rs-heads-icon" aria-hidden="true"><img src="/assets/survey-intro/icon-smile.svg" width="18" height="18" alt=""></span>
          <p>{welcome.note}</p>
        </div>
        <div class="rs-contact" id="g-contact" hidden></div>
        <button class="rs-begin" type="button" id="g-go">Begin <span class="rs-btn-icon" aria-hidden="true"></span></button>
        <p class="rs-known" id="g-known" hidden>Answering as <b id="g-known-name"></b>. <button type="button" id="g-not-me">Not you?</button></p>
        <p class="rs-micro"><img src="/assets/landing/icon-clock.svg" width="16" height="16" alt="">Takes about two minutes.</p>
      </div>

      <div class="rs-chat-wrap" id="chatWrap">
        <div class="rs-chat-lede">
          <h2>{chatIntro.lede}</h2>
          <p>{chatIntro.sub}</p>
        </div>
        <div class="chat-frame" id="frame">
          <div class="chat-head">
            <div>
              <b id="rs-title">{brand.chatTitle}</b>
              <small>{brand.poweredBy}</small>
            </div>
            <span class="chat-prog" id="rs-prog"></span>
          </div>
          <div class="chat-log" id="rs-log" aria-live="polite"></div>
          <div class="chat-input">
            <input id="rs-inp" type="text" autocomplete="off" placeholder="Tap an option above" aria-label="Your answer" disabled>
            <button class="send" id="rs-send" disabled>Send</button>
            <button class="chat-restart" type="button" id="rs-restart">Restart</button>
          </div>
        </div>
        <div class="rs-note" id="note">
          <button class="btn primary small" id="rs-review" type="button" hidden>Leave a review</button>
        </div>
      </div>

      <div class="rs-missing" id="missing" style={`display:${definition ? "none" : "block"}`}>
        This survey link is not working.<br>
        Ask whoever sent it for a fresh link.
      </div>
    </div>

    <div id="rrHandoff" class="rs-handoff" hidden>
      <div class="rs-handoff-card" role="dialog" aria-modal="true" aria-labelledby="rrHandoffTitle">
        <div id="rrHandoffAsk">
          <p class="rs-handoff-kicker" id="rrHandoffKicker">You’re all set</p>
          <h2 id="rrHandoffTitle"><span class="em">Thank you</span> for your time!</h2>
          <p class="rs-handoff-copy" id="rrHandoffLead">{clientName} has your answers.</p>
          <div class="rs-handoff-ask-block" id="rrHandoffAskBlock">
            <hr class="rs-handoff-rule">
            <h3 id="rrHandoffAskTitle">Would you mind leaving a <span class="em">review</span>?</h3>
            <p class="rs-handoff-copy" id="rrHandoffRest">Reputation Rocket will draft a public review from your answers and walk you through posting it — it only takes a minute.</p>
            <a class="rs-begin" href={reputationRocketUrl} id="rrHandoffGo" rel="noopener" target="_blank">
              Leave a review <span class="rs-btn-icon" aria-hidden="true"></span>
            </a>
            <button class="rs-handoff-already" type="button" id="rrHandoffAlready">I already left a review</button>
            <button class="rs-handoff-now" type="button" id="rrHandoffSkip">Skip for now</button>
          </div>
        </div>
        <div class="rs-handoff-follow" id="rrHandoffFollow" hidden>
          <div class="rs-handoff-confetti" id="rrHandoffConfetti" hidden aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </div>
          <div class="rs-handoff-check" id="rrHandoffCheck" hidden>
            <span></span>
          </div>
          <h2 id="rrHandoffFollowTitle">No problem, <span class="em">thank you</span></h2>
          <p class="rs-handoff-copy" id="rrHandoffFollowCopy">{clientName} has your answers.</p>
          {clientWebsite ? (
            <a class="rs-handoff-visit" href={clientWebsite} id="rrHandoffVisit" rel="noopener" target="_blank">
              {visitLabel} <span class="rs-btn-icon" aria-hidden="true"></span>
            </a>
          ) : (
            <a class="rs-handoff-visit" href="#" id="rrHandoffVisit" hidden>
              {visitLabel} <span class="rs-btn-icon" aria-hidden="true"></span>
            </a>
          )}
        </div>
        <div class="rs-handoff-results" id="rrHandoffResults" hidden>
          <h3>How others answered</h3>
          <p class="rs-result-meta" id="rrHandoffMeta"></p>
          <div class="rs-handoff-table-wrap is-short">
            <div class="rs-handoff-table" id="rrHandoffRows"></div>
            <div class="rs-handoff-view">
              <button class="rs-view-all" type="button" id="rrHandoffView">
                <span id="rrHandoffViewLabel">View All</span>
                <svg class="rs-view-all-ic" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3.333 8h9.334M8 3.333 12.667 8 8 12.667" stroke="currentColor" stroke-width="1.667" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="leadModal" class="rs-lead-modal" hidden>
      <div class="rs-lead-card" role="dialog" aria-modal="true" aria-labelledby="leadTitle">
        <h2 id="leadTitle">Before we begin</h2>
        <p class="rs-lead-copy" id="leadCopy">A few details so {clientName} can tie your answers to you.</p>
        <div id="hsFormTarget" class="rs-hs-form rs-hs-form-hidden" aria-hidden="true"></div>
        <div id="leadNative" class="rs-lead-native">
          <label class="flabel" for="g-first">First name <span class="req" aria-hidden="true">*</span></label>
          <input id="g-first" class="field" type="text" autocomplete="given-name" required aria-required="true">
          <label class="flabel" for="g-last">Last name <span class="req" aria-hidden="true">*</span></label>
          <input id="g-last" class="field" type="text" autocomplete="family-name" required aria-required="true">
          <label class="flabel" for="g-email">Email <span class="req" aria-hidden="true">*</span></label>
          <input id="g-email" class="field" type="email" autocomplete="email" required aria-required="true">
          <label class="flabel" for="g-company">Company name <span class="req" aria-hidden="true">*</span></label>
          <input id="g-company" class="field" type="text" autocomplete="organization" required aria-required="true">
          <label class="flabel" for="g-website">Website URL <span class="req" aria-hidden="true">*</span></label>
          <input id="g-website" class="field" type="text" autocomplete="url" placeholder="https://" required aria-required="true">
          <p class="rs-lead-error" id="leadError" role="alert" hidden></p>
          <button class="rs-begin" type="button" id="leadNativeGo">Continue</button>
        </div>
        <button class="rs-lead-close" type="button" id="leadClose">Cancel</button>
      </div>
    </div>

    <footer class="rs-foot">
      <div class="rs-foot-brand">
        <img class="ll" src="/assets/images/ll-tools.svg" width="122" height="30" alt="Lean Labs Tools">
      </div>
      <div class="rs-copy">
        <span>&copy; 2026 Survey Rocket.ai.</span>
      </div>
    </footer>
  </div>
  <script is:inline>window.SR_JUDGE_ENABLED = true;</script>
  <script is:inline src="/js/engine.js"></script>
  <script is:inline src="/js/crowd.js"></script>
  <script is:inline src="/js/transport.js"></script>
  <script is:inline define:vars={{ publicId, definition, clientName, clientKey, hubspotForm, reputationRocketUrl, clientWebsite }}>
    (function(){
      if(!definition || !definition.questions || !definition.questions.length){
        document.getElementById("frame").style.display="none";
        document.getElementById("note").style.display="none";
        document.getElementById("missing").style.display="block";
        document.getElementById("welcome").style.display="none";
        document.getElementById("steps").style.display="none";
        document.getElementById("chatWrap").style.display="none";
        return;
      }
      var survey = Object.assign({}, definition, { public_id: publicId, id: publicId });
      var settings = survey.settings || {};
      var contactAtEnd = settings.contact_at === "end";
      var lastAnswers=null, respondent={name:null,firstname:null,lastname:null,email:null,company:null,website:null};
      var run={id:SRHubSpot.uuid(), startedAt:null};
      var reviewStep=document.querySelector('#steps .rs-step[data-step="2"]');
      var postStep=document.querySelector('#steps .rs-step[data-step="3"]');
      function hideStep(el){
        if(!el) return;
        el.hidden=true;
        var line=el.previousElementSibling;
        if(line && line.classList.contains("rs-step-line")) line.hidden=true;
      }
      if(!settings.review_ask){
        hideStep(reviewStep);
        hideStep(postStep);
      }
      function setStep(i, allDone){
        var steps=document.querySelectorAll("#steps .rs-step");
        steps.forEach(function(el, idx){
          var done=!!allDone || idx<i;
          var on=!allDone && idx===i;
          el.classList.toggle("on", on);
          el.classList.toggle("done", done && !on);
          var pill=el.querySelector(".pill");
          if(pill) pill.textContent=done && !on ? "Completed" : (on ? "In Progress" : "Pending");
        });
        document.querySelectorAll("#steps .rs-step-line").forEach(function(line, idx){
          line.classList.toggle("fill", !!allDone || idx<i);
          line.classList.toggle("partial", !allDone && idx===i);
        });
      }
      function identityOpts(){
        return {
          clientResponseId:run.id, startedAt:run.startedAt,
          name:respondent.name, firstname:respondent.firstname, lastname:respondent.lastname,
          email:respondent.email, company:respondent.company, website:respondent.website
        };
      }
      function sendStart(){
        SRHubSpot.send(SRHubSpot.buildPayload(survey, {}, Object.assign({ status:"started" }, identityOpts())));
      }
      function sendProgress(answers){
        lastAnswers=answers;
        SRHubSpot.sendProgress(SRHubSpot.buildPayload(survey, answers, Object.assign({ status:"progress" }, identityOpts())));
      }
      function sendRecord(reviewAsked, reviewOutcome){
        if(!lastAnswers) return;
        SRHubSpot.send(SRHubSpot.buildPayload(survey, lastAnswers, Object.assign({
          status:"completed", reviewAsked:reviewAsked, reviewOutcome:reviewOutcome
        }, identityOpts())));
      }
      function enrollHubSpot(which){
        if(!respondent.email || respondent.email.indexOf("@")<1) return Promise.resolve();
        var timedOut=false;
        var timer=null;
        var request=fetch("/api/public/lists", {
          method:"POST",
          headers:{ "Content-Type":"application/json" },
          body:JSON.stringify({
            publicId:publicId,
            which:which,
            email:respondent.email,
            firstname:respondent.firstname,
            lastname:respondent.lastname,
            company:respondent.company,
            website:respondent.website
          })
        }).then(function(r){
          return r.json().catch(function(){ return {}; }).then(function(body){
            if(!r.ok || (body && body.ok===false)){
              console.error("hubspot lists", r.status, body && body.error);
            }
            return body;
          });
        }).catch(function(err){
          console.error("hubspot lists", err);
        });
        var timeout=new Promise(function(resolve){
          timer=setTimeout(function(){
            timedOut=true;
            resolve(null);
          }, 12000);
        });
        return Promise.race([request, timeout]).then(function(result){
          if(timer) clearTimeout(timer);
          if(timedOut) console.error("hubspot lists timed out", which);
          return result;
        });
      }
      var handoffTimer=null;
      var resultsOpen=false;
      var handoffView="ask";
      function hideHandoff(){
        if(handoffTimer){ clearTimeout(handoffTimer); handoffTimer=null; }
        var el=document.getElementById("rrHandoff");
        if(!el) return;
        el.classList.remove("open");
        el.hidden=true;
        setResultsOpen(false);
      }
      function setResultsOpen(open){
        resultsOpen=!!open;
        var box=document.getElementById("rrHandoffResults");
        var label=document.getElementById("rrHandoffViewLabel");
        if(box) box.classList.toggle("is-open", resultsOpen);
        if(label) label.textContent=resultsOpen ? "Show less" : "View All";
      }
      function setHandoffView(view){
        handoffView=view;
        var ask=document.getElementById("rrHandoffAsk");
        var follow=document.getElementById("rrHandoffFollow");
        var check=document.getElementById("rrHandoffCheck");
        var confetti=document.getElementById("rrHandoffConfetti");
        var followTitle=document.getElementById("rrHandoffFollowTitle");
        var followCopy=document.getElementById("rrHandoffFollowCopy");
        var visit=document.getElementById("rrHandoffVisit");
        var isFollow=view==="already" || view==="skip";
        if(ask) ask.hidden=isFollow;
        if(follow) follow.hidden=!isFollow;
        if(!isFollow) return;
        var celebrate=view==="already";
        if(check) check.hidden=!celebrate;
        if(confetti){
          confetti.classList.remove("is-on");
          confetti.hidden=!celebrate;
          if(celebrate){
            void confetti.offsetWidth;
            confetti.classList.add("is-on");
          }
        }
        if(followTitle){
          followTitle.classList.toggle("is-balance", celebrate);
          followTitle.innerHTML=celebrate
            ? "You just made our day — <span class=\"em\">thank you</span>!"
            : "No problem, <span class=\"em\">thank you</span>";
        }
        if(followCopy){
          followCopy.classList.toggle("is-balance", celebrate);
          followCopy.textContent=celebrate
            ? ("We really appreciate you sharing your feedback with "+clientName+".")
            : (clientName+" has your answers.");
        }
        if(visit){
          if(clientWebsite){
            visit.hidden=false;
            visit.href=clientWebsite;
          } else {
            visit.hidden=true;
          }
        }
      }
      function showHandoff(){
        if(!settings.review_ask && !settings.show_results) return;
        if(settings.review_ask && handoffView==="ask") setStep(2);
        var el=document.getElementById("rrHandoff");
        if(!el) return;
        setResultsOpen(false);
        el.hidden=false;
        requestAnimationFrame(function(){
          requestAnimationFrame(function(){ el.classList.add("open"); });
        });
        var go=document.getElementById("rrHandoffGo");
        var visit=document.getElementById("rrHandoffVisit");
        if(handoffView==="ask" && go && !go.hidden) go.focus();
        else if(visit && !visit.hidden) visit.focus();
      }
      function fitResults(){
        var table=document.getElementById("rrHandoffRows");
        var wrap=table && table.parentElement;
        if(!table || !wrap) return;
        wrap.classList.toggle("is-short", table.scrollHeight <= 240);
      }
      function renderCrowd(box, payload){
        if(!window.SRCrowd) return;
        SRCrowd.render(box, {
          questions: survey.questions || [],
          payload: payload || {},
          answers: lastAnswers || {}
        });
        fitResults();
      }
      function loadCrowd(){
        var meta=document.getElementById("rrHandoffMeta");
        var rows=document.getElementById("rrHandoffRows");
        if(!rows) return;
        rows.innerHTML="";
        var waiting=document.createElement("p");
        waiting.className="rs-crowd-empty";
        waiting.textContent="Loading how others answered…";
        rows.appendChild(waiting);
        if(meta) meta.textContent="";
        fitResults();
        fetch("/api/public/results/"+encodeURIComponent(publicId))
          .then(function(r){ return r.ok ? r.json() : null; })
          .then(function(data){
            if(meta) meta.textContent=window.SRCrowd ? SRCrowd.meta(data) : "";
            renderCrowd(rows, data);
          })
          .catch(function(){
            rows.innerHTML="";
            var err=document.createElement("p");
            err.className="rs-crowd-empty";
            err.textContent="Couldn't load other responses.";
            rows.appendChild(err);
            fitResults();
          });
      }
      function firstReviewUrl(){
        var links=settings.review_links||{};
        var keys=Object.keys(links).filter(function(p){ return (links[p]||"").trim(); });
        return keys.length ? links[keys[0]].trim() : "";
      }
      function appendContactParams(url){
        if(!url) return url;
        try{
          var u=new URL(url, window.location.origin);
          [
            ["firstname", respondent.firstname],
            ["lastname", respondent.lastname],
            ["email", respondent.email],
            ["company", respondent.company],
            ["website", respondent.website]
          ].forEach(function(pair){
            var value=pair[1] && String(pair[1]).trim();
            if(value) u.searchParams.set(pair[0], value);
          });
          return u.toString();
        }catch(e){
          return url;
        }
      }
      function reviewHandoffUrl(){
        return appendContactParams(firstReviewUrl() || reputationRocketUrl);
      }
      function showEnding(){
        var reviewBtn=document.getElementById("rs-review");
        var go=document.getElementById("rrHandoffGo");
        var title=document.getElementById("rrHandoffTitle");
        var lead=document.getElementById("rrHandoffLead");
        var askBlock=document.getElementById("rrHandoffAskBlock");
        var kicker=document.getElementById("rrHandoffKicker");
        var modalResults=document.getElementById("rrHandoffResults");
        if(go) go.href=reviewHandoffUrl();
        if(askBlock) askBlock.hidden=!settings.review_ask;
        if(kicker) kicker.hidden=!settings.review_ask;
        if(title){
          title.innerHTML=settings.review_ask
            ? "<span class=\"em\">Thank you</span> for your time!"
            : "Thanks for your <span class=\"em\">answers</span>";
        }
        if(lead){
          lead.textContent=settings.review_ask
            ? (clientName+" has your answers.")
            : "Here's how other people answered.";
        }
        setHandoffView("ask");
        if(reviewBtn){
          var showBtn=!!(settings.review_ask || settings.show_results);
          reviewBtn.hidden=!showBtn;
          reviewBtn.textContent=settings.review_ask ? "Leave a review" : "See how others answered";
        }
        if(settings.show_results){
          var card=document.querySelector(".rs-handoff-card");
          if(card) card.classList.add("is-wide");
          if(modalResults){
            modalResults.hidden=false;
            modalResults.classList.add("is-graph");
          }
          setResultsOpen(false);
          loadCrowd();
        } else if(modalResults){
          var cardNarrow=document.querySelector(".rs-handoff-card");
          if(cardNarrow) cardNarrow.classList.remove("is-wide");
          modalResults.hidden=true;
          modalResults.classList.remove("is-graph");
        }
      }
      function completeRun(answers){
        lastAnswers=answers;
        enrollHubSpot("completed").finally(function(){
          sendRecord(!!settings.review_ask, settings.review_ask ? "shown" : "not_asked");
        });
        showEnding();
        if(settings.review_ask || settings.show_results){
          if(handoffTimer) clearTimeout(handoffTimer);
          handoffTimer=setTimeout(showHandoff, 600);
        } else {
          setStep(1, true);
        }
      }
      var chat=new SurveyChat({
        log:document.getElementById("rs-log"),
        input:document.getElementById("rs-inp"),
        sendBtn:document.getElementById("rs-send"),
        progEl:document.getElementById("rs-prog"),
        script:survey.questions,
        outro: survey.outro || "That is everything. Thank you.",
        onAnswer:function(_id, _value, answers){
          sendProgress(answers);
        },
        onComplete:function(answers){
          lastAnswers=answers;
          if(contactAtEnd && !respondent.email){
            // Save the answers now, so someone who skips the details step still counts.
            sendRecord(false, "not_asked");
            openLeadModal("end");
            return;
          }
          completeRun(answers);
        }
      });
      function startRun(){
        run.id=SRHubSpot.uuid();
        run.startedAt=new Date().toISOString();
        sendStart();
        var reviewBtn=document.getElementById("rs-review");
        if(reviewBtn) reviewBtn.hidden=true;
        var modalResults=document.getElementById("rrHandoffResults");
        if(modalResults){
          modalResults.hidden=true;
          modalResults.classList.remove("is-open");
          modalResults.classList.remove("is-graph");
        }
        var card=document.querySelector(".rs-handoff-card");
        if(card) card.classList.remove("is-wide");
        hideHandoff();
        setHandoffView("ask");
        setStep(1);
        chat.start();
      }
      document.getElementById("rs-restart").addEventListener("click",startRun);
      var welcome=document.getElementById("welcome"), chatWrap=document.getElementById("chatWrap");
      var modal=document.getElementById("leadModal");
      var hsMounted=false, hsReady=false, hsFailed=false, leadBusy=false, startedFromLead=false, signedInEnroll=null;
      function fieldVal(data, name){
        if(!Array.isArray(data)) return "";
        var hit=data.find(function(f){
          var n=String(f.name||"").split("/").pop();
          return n===name;
        });
        return hit && hit.value!=null ? String(hit.value).trim() : "";
      }
      function applyIdentity(vals){
        respondent.firstname=vals.firstname||null;
        respondent.lastname=vals.lastname||null;
        respondent.email=(vals.email||"").toLowerCase()||null;
        respondent.company=vals.company||null;
        respondent.website=vals.website||null;
        respondent.name=[respondent.firstname, respondent.lastname].filter(Boolean).join(" ")||null;
      }
      // Known people skip the contact form: a link that carries their details
      // (e.g. HubSpot email tokens, ?email={{contact.email}}), or details they
      // already gave this client on this device.
      var CONTACT_KEY="sr:contact:v1:"+clientKey;
      var CONTACT_PARAMS={
        firstname:["firstname","first_name"],
        lastname:["lastname","last_name"],
        email:["email"],
        company:["company"],
        website:["website"]
      };
      function validEmail(value){
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value||"").trim());
      }
      function contactFromLink(){
        var url;
        try{ url=new URL(window.location.href); }catch(e){ return null; }
        var vals={}, seen=false;
        Object.keys(CONTACT_PARAMS).forEach(function(key){
          CONTACT_PARAMS[key].forEach(function(param){
            if(!url.searchParams.has(param)) return;
            seen=true;
            var value=(url.searchParams.get(param)||"").trim();
            if(value && !vals[key]) vals[key]=value;
            url.searchParams.delete(param);
          });
        });
        // Keep the details out of the address bar, screenshots and shared links.
        if(seen){
          try{ history.replaceState(history.state, "", url.pathname+url.search+url.hash); }catch(e){}
        }
        return validEmail(vals.email) ? vals : null;
      }
      function rememberedContact(){
        if(!clientKey) return null;
        try{
          var saved=JSON.parse(localStorage.getItem(CONTACT_KEY)||"null");
          return saved && validEmail(saved.email) ? saved : null;
        }catch(e){ return null; }
      }
      function rememberContact(){
        if(!clientKey || !validEmail(respondent.email)) return;
        try{
          localStorage.setItem(CONTACT_KEY, JSON.stringify({
            firstname:respondent.firstname, lastname:respondent.lastname, email:respondent.email,
            company:respondent.company, website:respondent.website
          }));
        }catch(e){}
      }
      var knownContact=contactFromLink()||rememberedContact();
      function showKnownContact(){
        var line=document.getElementById("g-known");
        if(!line) return;
        if(!knownContact){ line.hidden=true; return; }
        var name=[knownContact.firstname, knownContact.lastname].filter(Boolean).join(" ");
        document.getElementById("g-known-name").textContent=name || knownContact.email;
        line.hidden=false;
      }
      showKnownContact();
      document.getElementById("g-not-me").addEventListener("click", function(){
        knownContact=null;
        try{ localStorage.removeItem(CONTACT_KEY); }catch(e){}
        showKnownContact();
      });
      function closeLeadModal(){
        modal.hidden=true;
        modal.classList.remove("open");
        document.getElementById("g-go").classList.remove("is-busy");
        document.getElementById("leadNativeGo").classList.remove("is-busy");
        leadBusy=false;
      }
      function enterChat(){
        if(startedFromLead) return;
        startedFromLead=true;
        closeLeadModal();
        welcome.style.display="none";
        var page=document.querySelector(".rs-page");
        if(page) page.classList.add("is-chat");
        chatWrap.style.display="flex";
        startRun();
      }
      function enrollSignedIn(){
        if(signedInEnroll) return signedInEnroll;
        signedInEnroll=enrollHubSpot("signedIn");
        return signedInEnroll;
      }
      function beginAfterIdentity(){
        if(startedFromLead) return;
        rememberContact();
        enrollSignedIn().finally(function(){
          enterChat();
        });
      }
      var leadMode="start", finishedAtEnd=false;
      function finishAfterIdentity(){
        if(finishedAtEnd) return;
        finishedAtEnd=true;
        rememberContact();
        closeLeadModal();
        enrollSignedIn();
        completeRun(lastAnswers);
      }
      function afterIdentity(){
        if(leadMode==="end") finishAfterIdentity();
        else beginAfterIdentity();
      }
      function openLeadModal(mode){
        leadMode=mode;
        var atEnd=mode==="end";
        var compare=atEnd && !!settings.show_results;
        document.getElementById("leadTitle").textContent=
          compare ? "See how you compare" : (atEnd ? "One last thing" : "Before we begin");
        document.getElementById("leadCopy").textContent=compare
          ? "Add your details to see how your answers stack up against everyone else's."
          : ("A few details so "+clientName+" can tie your answers to you.");
        document.getElementById("leadNativeGo").textContent=
          compare ? "Show my results" : (atEnd ? "Finish" : "Continue");
        document.getElementById("leadClose").textContent=atEnd ? "No thanks" : "Cancel";
        if(!atEnd) document.getElementById("g-go").classList.add("is-busy");
        modal.hidden=false;
        modal.classList.add("open");
        if(hubspotForm && hubspotForm.portalId && hubspotForm.formId){
          loadHsForms().then(mountHsForm).catch(function(){ hsFailed=true; });
        } else {
          hsFailed=true;
        }
      }
      function readLeadFields(){
        return {
          firstname: document.getElementById("g-first").value.trim(),
          lastname: document.getElementById("g-last").value.trim(),
          email: document.getElementById("g-email").value.trim(),
          company: document.getElementById("g-company").value.trim(),
          website: document.getElementById("g-website").value.trim()
        };
      }
      var leadIds=["g-first","g-last","g-email","g-company","g-website"];
      function leadErrorEl(){ return document.getElementById("leadError"); }
      function markLeadField(el, invalid){
        el.classList.toggle("is-error", invalid);
        if(invalid) el.setAttribute("aria-invalid", "true");
        else el.removeAttribute("aria-invalid");
      }
      function setLeadError(message){
        var box=leadErrorEl();
        if(!box) return;
        box.textContent=message||"";
        box.hidden=!message;
      }
      function validateLead(){
        var firstInvalid=null;
        var emailInvalid=false;
        var anyEmpty=false;
        leadIds.forEach(function(id){
          var el=document.getElementById(id);
          if(!el) return;
          var invalid=!el.checkValidity();
          markLeadField(el, invalid);
          if(!invalid) return;
          if(!firstInvalid) firstInvalid=el;
          if(!el.value.trim()) anyEmpty=true;
          if(id==="g-email" && el.value.trim()) emailInvalid=true;
        });
        if(!firstInvalid){
          setLeadError("");
          return true;
        }
        var message=anyEmpty
          ? "Please fill in all required fields."
          : "Enter a valid email address.";
        if(anyEmpty && emailInvalid) message="Please fill in all required fields. Enter a valid email address.";
        setLeadError(message);
        firstInvalid.focus();
        return false;
      }
      leadIds.forEach(function(id){
        var el=document.getElementById(id);
        if(!el) return;
        el.addEventListener("input", function(){
          if(el.checkValidity()) markLeadField(el, false);
          if(leadIds.every(function(fid){
            var field=document.getElementById(fid);
            return !field || field.checkValidity();
          })) setLeadError("");
        });
      });
      function setHsField(form, name, value){
        var el=form.querySelector('[name="'+name+'"]')
          || form.querySelector('[name="0-1/'+name+'"]')
          || form.querySelector('input[id*="'+name+'"]');
        if(!el) return;
        el.value=value;
        el.dispatchEvent(new Event("input", { bubbles:true }));
        el.dispatchEvent(new Event("change", { bubbles:true }));
      }
      function submitHiddenHsForm(vals){
        var form=document.querySelector("#hsFormTarget form");
        if(!form) return false;
        setHsField(form, "firstname", vals.firstname);
        setHsField(form, "lastname", vals.lastname);
        setHsField(form, "email", vals.email);
        setHsField(form, "company", vals.company);
        setHsField(form, "website", vals.website);
        var btn=form.querySelector('input[type="submit"], button[type="submit"], .hs-button');
        if(btn) btn.click();
        else form.dispatchEvent(new Event("submit", { bubbles:true, cancelable:true }));
        return true;
      }
      function loadHsForms(){
        return new Promise(function(resolve, reject){
          if(window.hbspt && window.hbspt.forms && window.hbspt.forms.create) return resolve();
          var existing=document.querySelector('script[src*="js.hsforms.net/forms/embed/v2.js"]');
          if(existing){
            existing.addEventListener("load", function(){ resolve(); });
            existing.addEventListener("error", function(){ reject(new Error("forms")); });
            return;
          }
          var s=document.createElement("script");
          s.src="https://js.hsforms.net/forms/embed/v2.js";
          s.charset="utf-8";
          s.async=true;
          s.onload=function(){ resolve(); };
          s.onerror=function(){ reject(new Error("forms")); };
          document.head.appendChild(s);
        });
      }
      function mountHsForm(){
        if(hsMounted) return;
        var target=document.getElementById("hsFormTarget");
        target.innerHTML="";
        window.hbspt.forms.create({
          portalId: String(hubspotForm.portalId),
          formId: String(hubspotForm.formId),
          region: "na1",
          target: "#hsFormTarget",
          cssRequired: false,
          css: "",
          onFormReady: function(){ hsReady=true; }
        });
        hsMounted=true;
      }
      window.addEventListener("message", function(event){
        if(!event.data || event.data.type!=="hsFormCallback") return;
        if(event.data.eventName!=="onFormSubmit" && event.data.eventName!=="onFormSubmitted") return;
        if(hubspotForm && event.data.id && event.data.id!==hubspotForm.formId) return;
        applyIdentity({
          firstname: fieldVal(event.data.data, "firstname") || respondent.firstname,
          lastname: fieldVal(event.data.data, "lastname") || respondent.lastname,
          email: fieldVal(event.data.data, "email") || respondent.email,
          company: fieldVal(event.data.data, "company") || respondent.company,
          website: fieldVal(event.data.data, "website") || respondent.website
        });
        if(!respondent.email || respondent.email.indexOf("@")<1) return;
        if(event.data.eventName!=="onFormSubmitted") return;
        if(leadMode==="end"){
          finishAfterIdentity();
          return;
        }
        if(startedFromLead){
          sendStart();
          return;
        }
        beginAfterIdentity();
      });
      function finishLeadWithoutHs(){
        var vals=readLeadFields();
        applyIdentity(vals);
        if(!respondent.email || respondent.email.indexOf("@")<1) return;
        afterIdentity();
      }
      function waitForHs(cb){
        if(!hubspotForm || hsFailed || hsReady) return cb();
        var n=0;
        var t=setInterval(function(){
          n++;
          if(hsReady || hsFailed || n>50){
            clearInterval(t);
            cb();
          }
        }, 100);
      }
      document.getElementById("leadNativeGo").addEventListener("click", function(){
        if(leadBusy) return;
        if(!validateLead()) return;
        var vals=readLeadFields();
        applyIdentity(vals);
        var go=document.getElementById("leadNativeGo");
        go.classList.add("is-busy");
        leadBusy=true;
        waitForHs(function(){
          if(hubspotForm && !hsFailed && submitHiddenHsForm(vals)){
            setTimeout(afterIdentity, 8000);
            return;
          }
          afterIdentity();
        });
      });
      document.getElementById("leadClose").addEventListener("click", function(){
        closeLeadModal();
        if(leadMode!=="end") return;
        // Skipped the details: answers are already saved without a name.
        // Leave a way back in when there are results to unlock.
        setStep(1, true);
        var reviewBtn=document.getElementById("rs-review");
        if(reviewBtn && settings.show_results){
          reviewBtn.textContent="See how you compare";
          reviewBtn.hidden=false;
        }
      });
      document.getElementById("g-go").addEventListener("click", function(){
        if(knownContact){
          applyIdentity(knownContact);
          beginAfterIdentity();
          return;
        }
        if(contactAtEnd){
          enterChat();
          return;
        }
        openLeadModal("start");
      });
      function finishReview(outcome, view){
        sendRecord(true, outcome);
        setHandoffView(view);
        setStep(2, true);
      }
      document.getElementById("rrHandoffGo").addEventListener("click", function(){
        this.href=reviewHandoffUrl();
        sendRecord(true, "clicked");
        setStep(3);
      });
      document.getElementById("rrHandoffAlready").addEventListener("click", function(){
        finishReview("dismissed", "already");
      });
      document.getElementById("rrHandoffSkip").addEventListener("click", function(){
        finishReview("declined", "skip");
      });
      document.getElementById("rrHandoff").addEventListener("click", function(e){
        if(e.target!==this) return;
        if(handoffView==="ask" && settings.review_ask) finishReview("declined", "skip");
        else hideHandoff();
      });
      document.addEventListener("keydown", function(e){
        if(e.key!=="Escape") return;
        var el=document.getElementById("rrHandoff");
        if(!el || el.hidden) return;
        if(handoffView==="ask" && settings.review_ask) finishReview("declined", "skip");
        else hideHandoff();
      });
      document.getElementById("rs-review").addEventListener("click",function(){
        if(contactAtEnd && !respondent.email && lastAnswers){
          openLeadModal("end");
          return;
        }
        showHandoff();
      });
      document.getElementById("rrHandoffView").addEventListener("click", function(){
        setResultsOpen(!resultsOpen);
      });
    })();
  </script>
</Base>
)}
