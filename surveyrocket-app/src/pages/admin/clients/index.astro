---
import Base from "../../../layouts/Base.astro";
import AdminShell from "../../../components/AdminShell.astro";
import { adminWorkspaceOverview } from "../../../lib/access";

const { clients } = await adminWorkspaceOverview();
---
<Base title="Clients · Admin">
  <AdminShell current="clients" email={Astro.locals.user?.email}>
    <div class="wrap">
      <div class="pagehead">
        <h1>Clients</h1>
        <p>Create a portal, decide who gets in, then open it only when you need to work as that client.</p>
      </div>
      <p class="admin-actions">
        <a class="btn primary" href="/admin/clients/new">New client</a>
      </p>
      <table class="raw">
        <thead><tr><th>Name</th><th>Users</th><th>Surveys</th><th>Results</th><th>HubSpot</th><th></th></tr></thead>
        <tbody>
          {clients.map((c) => (
            <tr>
              <td>{c.name}<div style="color:var(--tx-3);font-size:11px">{c.slug}</div></td>
              <td>{c.users}</td>
              <td>{c.surveys}</td>
              <td>{c.responses}</td>
              <td>{c.hubspot}</td>
              <td>
                <a href={`/admin/clients/${c.slug}`}>Manage access</a>
                · <a href={`/app/${c.slug}/dashboard`}>Open portal</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </AdminShell>
</Base>
