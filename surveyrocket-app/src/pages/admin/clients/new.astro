---
import Base from "../../../layouts/Base.astro";
import AdminShell from "../../../components/AdminShell.astro";
---
<Base title="New client · Admin">
  <AdminShell current="clients" email={Astro.locals.user?.email}>
    <div class="wrap">
      <p><a href="/admin/clients">← Clients</a></p>
      <div class="pagehead">
        <h1>New client</h1>
        <p>Creates their portal. The first user gets a password setup email — they choose their own password.</p>
      </div>
      <form id="f">
        <label>Name</label>
        <input name="name" required />
        <label>Slug</label>
        <input name="slug" placeholder="acme" />
        <label>Logo URL</label>
        <input name="logoUrl" />
        <label>First user email</label>
        <input name="inviteEmail" type="email" placeholder="they will get a password setup email" />
        <button class="btn primary" type="submit" style="margin-top:16px">Create</button>
        <p id="err" class="emptystate" hidden style="color:var(--red);margin-top:12px"></p>
      </form>
    </div>
  </AdminShell>
  <style>
    label{display:block;font-size:12px;color:var(--tx-3);text-transform:uppercase;letter-spacing:.07em;margin:12px 0 6px}
    input,select{width:100%;background:var(--page);box-shadow:var(--inset);border:0;border-radius:var(--r-md);padding:11px 14px;color:var(--tx)}
  </style>
  <script>
    document.getElementById("f")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const err = document.getElementById("err")!;
      err.hidden = true;
      const fd = new FormData(e.target as HTMLFormElement);
      const res = await fetch("/api/admin/clients", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: fd.get("name"),
          slug: fd.get("slug"),
          logoUrl: fd.get("logoUrl"),
          inviteEmail: fd.get("inviteEmail"),
        }),
      });
      const data = await res.json();
      if (data.client?.slug) {
        location.href = `/admin/clients/${data.client.slug}`;
        return;
      }
      err.hidden = false;
      err.textContent = data.error || "Could not create client.";
    });
  </script>
</Base>
