---
import Base from "../../../layouts/Base.astro";
import AdminShell from "../../../components/AdminShell.astro";
---
<Base title="New client · Admin">
  <AdminShell current="clients" email={Astro.locals.user?.email}>
    <div class="wrap">
      <a class="admin-back" href="/admin/clients">← Clients</a>
      <div class="pagehead">
        <h1>New client</h1>
        <p>Creates their portal. The first user gets a password setup email — they choose their own password.</p>
      </div>
      <div class="admin-card">
        <form id="f">
          <div class="admin-field">
            <label for="client-name">Name</label>
            <input id="client-name" name="name" required placeholder="Acme Inc." />
          </div>
          <div class="admin-field">
            <label for="client-slug">Slug <span style="text-transform:none;letter-spacing:0;color:var(--tx-3)">(optional)</span></label>
            <input id="client-slug" name="slug" placeholder="acme" />
          </div>
          <div class="admin-field">
            <label for="client-invite">First user email</label>
            <input id="client-invite" name="inviteEmail" type="email" placeholder="they will get a password setup email" />
          </div>
          <button class="btn primary" type="submit">Create portal</button>
          <p id="err" class="emptystate" hidden style="color:var(--red);margin-top:12px"></p>
        </form>
      </div>
    </div>
  </AdminShell>
  <script>
    document.getElementById("f")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const err = document.getElementById("err")!;
      err.hidden = true;
      const fd = new FormData(e.target as HTMLFormElement);
      const res = await fetch("/api/admin/clients", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: fd.get("name"),
          slug: fd.get("slug"),
          inviteEmail: fd.get("inviteEmail"),
        }),
      });
      const data = await res.json();
      if (data.client?.slug) {
        location.href = `/admin/clients/${data.client.slug}`;
        return;
      }
      err.hidden = false;
      err.textContent = data.error || "Could not create client.";
    });
  </script>
</Base>
