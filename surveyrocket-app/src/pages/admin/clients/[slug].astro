---
import Base from "../../../layouts/Base.astro";
import AdminShell from "../../../components/AdminShell.astro";
import { clientBySlug, hubspotStatusByClient, membersForClient } from "../../../lib/access";

const slug = Astro.params.slug!;
const client = await clientBySlug(slug);
if (!client) return Astro.redirect("/admin/clients");
const conn = (await hubspotStatusByClient()).get(client.id);
const members = await membersForClient(client.id);
const hubspotLabel = conn?.status || "disconnected";
const hubspotConnected = hubspotLabel === "connected";
---
<Base title={`${client.name} · Admin`}>
  <AdminShell current="clients" email={Astro.locals.user?.email}>
    <div class="wrap">
      <a class="admin-back" href="/admin/clients">← Clients</a>
      <div class="admin-head">
        <div class="pagehead">
          <h1>{client.name}</h1>
          <p>Who can sign in to this portal, and a way to open it with full access.</p>
          <div class="admin-meta">
            <span class="chip">{client.slug}</span>
            <span class:list={["chip", hubspotConnected ? "teal" : "gold"]}>
              HubSpot {hubspotConnected ? "connected" : hubspotLabel}{conn?.portalId ? ` · ${conn.portalId}` : ""}
            </span>
          </div>
        </div>
        <a class="btn primary" href={`/app/${client.slug}/dashboard`}>Open portal</a>
      </div>

      <div class="admin-card">
        <h2>People</h2>
        <p class="lede">Invite sent is a pending account so we can email them — they cannot use this portal until they set a password. Accepted means they finished setup. You can delete a pending invite and send a new one.</p>
        {members.length === 0 ? (
          <p class="emptystate" style="margin:0 0 16px">No one yet. Send an invite below.</p>
        ) : (
          <table class="raw">
            <thead>
              <tr>
                <th>Email</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {members.map((m) => (
                <tr>
                  <td>
                    {m.fullName ? (
                      <>
                        {m.fullName}
                        <div style="color:var(--tx-3);font-size:11px">{m.email}</div>
                      </>
                    ) : (
                      m.email
                    )}
                  </td>
                  <td>
                    {m.inviteStatus === "signed_in" ? (
                      <span class="chip teal">Accepted</span>
                    ) : (
                      <span class="chip gold">Invite sent</span>
                    )}
                  </td>
                  <td>
                    {m.inviteStatus !== "signed_in" && m.email ? (
                      <div class="row-actions">
                        <button class="btn ghost small" type="button" data-resend={m.email}>Resend invite</button>
                        <button class="btn ghost small" type="button" data-remove={m.userId} data-email={m.email}>Remove invite</button>
                      </div>
                    ) : null}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        <form id="invite" class="invite-follow">
          <div class="invite-row">
            <input id="invite-email" name="email" type="email" placeholder="first.user@client.com" required />
            <button class="btn primary" type="submit">Send invite</button>
          </div>
          <p id="invite-msg" class="emptystate" hidden style="margin-top:12px"></p>
        </form>
      </div>
    </div>
  </AdminShell>
  <script define:vars={{ slug }}>
    const msg = document.getElementById("invite-msg");
    function showMsg(text, ok) {
      if (!msg) return;
      msg.hidden = false;
      msg.style.color = ok ? "var(--tx-2)" : "var(--red)";
      msg.textContent = text;
    }
    async function sendInvite(email, resend, btn) {
      if (btn) {
        btn.disabled = true;
        btn.setAttribute("aria-busy", "true");
      }
      try {
        const res = await fetch("/api/app/members", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ client: slug, email, resend: !!resend }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          showMsg(data.error || "Could not invite that user.", false);
          return false;
        }
        return true;
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.removeAttribute("aria-busy");
        }
      }
    }
    document.getElementById("invite").addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const btn = e.target.querySelector("[type=submit]");
      const ok = await sendInvite(fd.get("email"), false, btn);
      if (ok) location.reload();
    });
    document.querySelectorAll("[data-resend]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const ok = await sendInvite(btn.getAttribute("data-resend"), true, btn);
        if (ok) showMsg("Invite resent. They will get a fresh email to set a password.", true);
      });
    });
    document.querySelectorAll("[data-remove]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const email = btn.getAttribute("data-email") || "this invite";
        if (!confirm(`Delete the invite for ${email}? They will disappear until you send a new one.`)) return;
        btn.disabled = true;
        btn.setAttribute("aria-busy", "true");
        try {
          const res = await fetch("/api/app/members", {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ client: slug, userId: btn.getAttribute("data-remove") }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            showMsg(data.error || "Could not remove that invite.", false);
            return;
          }
          location.reload();
        } finally {
          btn.disabled = false;
          btn.removeAttribute("aria-busy");
        }
      });
    });
  </script>
</Base>
