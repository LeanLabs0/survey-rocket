---
import Base from "../../../layouts/Base.astro";
import AdminShell from "../../../components/AdminShell.astro";
import { clientBySlug, hubspotStatusByClient, membersForClient } from "../../../lib/access";

const slug = Astro.params.slug!;
const client = await clientBySlug(slug);
if (!client) return Astro.redirect("/admin/clients");
const conn = (await hubspotStatusByClient()).get(client.id);
const members = await membersForClient(client.id);
---
<Base title={`${client.name} · Admin`}>
  <AdminShell current="clients" email={Astro.locals.user?.email}>
    <div class="wrap">
      <p><a href="/admin/clients">← Clients</a></p>
      <div class="pagehead">
        <h1>{client.name}</h1>
        <p>Who can sign in to this portal, and a way to open it with full access.</p>
      </div>
      <p>Slug: {client.slug}</p>
      <p>HubSpot: {conn?.status || "disconnected"}{conn?.portalId ? ` · portal ${conn.portalId}` : ""}</p>
      <p class="admin-actions">
        <a class="btn primary" href={`/app/${client.slug}/dashboard`}>Open portal</a>
      </p>
      <h3>Users</h3>
      <ul>
        {members.length === 0 && <li>No users yet. Send a password setup email below.</li>}
        {members.map((m) => (
          <li>{m.email} · {m.role}</li>
        ))}
      </ul>
      <form id="invite">
        <label for="invite-email">Add a user</label>
        <input id="invite-email" name="email" type="email" placeholder="first.user@client.com" required />
        <label for="invite-role">Role</label>
        <select id="invite-role" name="role">
          <option value="owner">Owner</option>
          <option value="member">Member</option>
        </select>
        <button class="btn ghost" type="submit" style="margin-top:14px">Send password setup email</button>
        <p id="invite-msg" class="emptystate" hidden style="margin-top:10px"></p>
      </form>
    </div>
  </AdminShell>
  <style>
    label{display:block;font-size:12px;color:var(--tx-3);text-transform:uppercase;letter-spacing:.07em;margin:12px 0 6px}
    input,select{width:100%;background:var(--page);box-shadow:var(--inset);border:0;border-radius:var(--r-md);padding:11px 14px;color:var(--tx)}
  </style>
  <script define:vars={{ slug }}>
    document.getElementById("invite")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const msg = document.getElementById("invite-msg")!;
      const res = await fetch("/api/app/members", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ client: slug, email: fd.get("email"), role: fd.get("role") }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        msg.hidden = false;
        msg.style.color = "var(--red)";
        msg.textContent = data.error || "Could not invite that user.";
        return;
      }
      location.reload();
    });
  </script>
</Base>
