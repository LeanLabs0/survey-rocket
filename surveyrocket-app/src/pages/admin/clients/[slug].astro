---
import Base from "../../../layouts/Base.astro";
import AdminShell from "../../../components/AdminShell.astro";
import { clientBySlug, hubspotStatusByClient, membersForClient } from "../../../lib/access";

const slug = Astro.params.slug!;
const client = await clientBySlug(slug);
if (!client) return Astro.redirect("/admin/clients");
const conn = (await hubspotStatusByClient()).get(client.id);
const members = await membersForClient(client.id);
const hubspotLabel = conn?.status || "disconnected";
const hubspotConnected = hubspotLabel === "connected";
---
<Base title={`${client.name} · Admin`}>
  <AdminShell current="clients" email={Astro.locals.user?.email}>
    <div class="wrap">
      <a class="admin-back" href="/admin/clients">← Clients</a>
      <div class="admin-head">
        <div class="pagehead">
          <h1>{client.name}</h1>
          <p>Who can sign in to this portal, and a way to open it with full access.</p>
          <div class="admin-meta">
            <span class="chip">{client.slug}</span>
            <span class:list={["chip", hubspotConnected ? "teal" : "gold"]}>
              HubSpot {hubspotConnected ? "connected" : hubspotLabel}{conn?.portalId ? ` · ${conn.portalId}` : ""}
            </span>
          </div>
        </div>
        <a class="btn primary" href={`/app/${client.slug}/dashboard`}>Open portal</a>
      </div>

      <div class="admin-card">
        <h2>People</h2>
        <p class="lede">Invite sent means they have an email to set a password. Accepted means they have signed in.</p>
        {members.length === 0 ? (
          <p class="emptystate" style="margin:0 0 16px">No one yet. Send an invite below.</p>
        ) : (
          <table class="raw">
            <thead>
              <tr>
                <th>Email</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {members.map((m) => (
                <tr>
                  <td>
                    {m.fullName ? (
                      <>
                        {m.fullName}
                        <div style="color:var(--tx-3);font-size:11px">{m.email}</div>
                      </>
                    ) : (
                      m.email
                    )}
                  </td>
                  <td>
                    {m.inviteStatus === "signed_in" ? (
                      <span class="chip teal">Accepted</span>
                    ) : (
                      <span class="chip gold">Invite sent</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        <form id="invite" class="invite-follow">
          <div class="invite-row">
            <input id="invite-email" name="email" type="email" placeholder="first.user@client.com" required />
            <button class="btn primary" type="submit">Send invite</button>
          </div>
          <p id="invite-msg" class="emptystate" hidden style="margin-top:12px"></p>
        </form>
      </div>
    </div>
  </AdminShell>
  <script define:vars={{ slug }}>
    document.getElementById("invite")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const msg = document.getElementById("invite-msg")!;
      const res = await fetch("/api/app/members", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ client: slug, email: fd.get("email") }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        msg.hidden = false;
        msg.style.color = "var(--red)";
        msg.textContent = data.error || "Could not invite that user.";
        return;
      }
      location.reload();
    });
  </script>
</Base>
