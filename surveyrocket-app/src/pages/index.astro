---
import "../styles/styles-shared.css";
import "../styles/styles-landing.css";
import { appOrigin } from "../lib/site";

const demo = `${appOrigin()}/demo`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Survey Rocket</title>
<meta name="description" content="Turn customer surveys into stats you can publish. Survey Rocket asks your questions in a chat and turns results into numbers for your website.">
<link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>

  body{font-size:16px}
  .topbar{position:sticky;top:0;z-index:40;display:flex;align-items:center;gap:14px;height:60px;padding:0 24px;background:var(--page);border-bottom:1px solid var(--line)}
  .wordmark{display:flex;align-items:center;gap:10px;font-family:var(--font-heading);font-weight:600;font-size:17px;color:var(--tx);text-decoration:none}
  .wordmark .rocket{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:var(--r-md);background:var(--tile);box-shadow:var(--inset);color:var(--tx);font-size:12px;font-weight:600}
  .topnav{margin-left:auto;display:flex;gap:8px;align-items:center}
  .topnav a{color:var(--tx-2);text-decoration:none;font-size:14px;padding:8px 14px;border-radius:999px}
  .topnav a:hover{color:var(--tx);background:var(--btn)}
  .topnav a.cta{background:var(--tx);color:var(--page);font-weight:500}
  .topnav a.cta:hover{background:#E6E6E6}
  @media (max-width:560px){.topnav a.plain{display:none}}
  .view{display:none}
  .view.active{display:block}
  .wrap{max-width:1020px;margin:0 auto;padding:0 24px}

  .hero{padding:88px 0 64px;text-align:center}
  .hero .eyebrow{font-size:12px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--tx-2)}
  .hero h1{font-size:clamp(32px,5.4vw,54px);line-height:1.15;letter-spacing:-.02em;margin:.35em auto .3em;max-width:17ch;text-wrap:balance}
  .hero p{max-width:52ch;margin:0 auto;font-size:18px}
  .hero .ctas{margin-top:30px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .hero .btn{padding:13px 26px;font-size:15px}
  .hero .note{margin-top:12px;font-size:13px;color:var(--tx-3)}

  .vid{margin:0;padding:8px 0 64px}
  .vid-frame{position:relative;max-width:760px;margin:0 auto;aspect-ratio:16/9;background:var(--card);box-shadow:var(--inset);border-radius:var(--r-lg);display:flex;align-items:center;justify-content:center;overflow:hidden}
  .vid-frame .play{width:74px;height:74px;border-radius:50%;background:var(--tx);border:0;display:flex;align-items:center;justify-content:center;cursor:not-allowed}
  .vid-frame .play::before{content:"";display:block;margin-left:6px;border-style:solid;border-width:14px 0 14px 24px;border-color:transparent transparent transparent var(--page)}
  .vid-frame .third{position:absolute;left:20px;bottom:18px;text-align:left}
  .vid-frame .third b{display:block;font-family:var(--font-heading);font-weight:600;color:var(--tx);font-size:15px}
  .vid-frame .third span{font-size:12.5px;color:var(--tx-2)}
  .vid-frame .dur{position:absolute;right:20px;bottom:20px;font-size:12px;color:var(--tx-2);box-shadow:var(--inset);border-radius:var(--r-sm);padding:3px 9px;background:rgba(13,13,13,.6)}
  .vid .cap{text-align:center;font-size:12.5px;color:var(--tx-2);margin-top:12px}

  .steps{padding:24px 0 72px}
  .steps h2{text-align:center;font-size:26px;margin-bottom:8px}
  .steps .sub{text-align:center;color:var(--tx-2);margin:0 0 34px}
  .stepgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  @media (max-width:820px){.stepgrid{grid-template-columns:1fr}}
  .stepcard{background:var(--card);box-shadow:var(--inset);border-radius:var(--r-lg);padding:28px 24px}
  .stepcard .n{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:var(--tile);color:var(--tx);font-weight:600;font-size:13px;font-variant-numeric:tabular-nums;margin-bottom:14px}
  .stepcard h3{font-size:17px;margin-bottom:8px}
  .stepcard p{margin:0;font-size:14.5px}

  .why{padding:0 0 72px}
  .whycard{background:var(--card);box-shadow:var(--inset);border-radius:var(--r-lg);padding:36px;display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center}
  @media (max-width:820px){.whycard{grid-template-columns:1fr}}
  .whycard h2{font-size:24px;margin-bottom:10px;text-wrap:balance}
  .whycard p{margin:0 0 10px;font-size:15px}
  .statrow{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .ministat{background:var(--btn);box-shadow:var(--inset);border-radius:var(--r-md);padding:16px}
  .ministat .num{font-family:var(--font-heading);font-size:24px;font-weight:600;color:var(--tx);font-variant-numeric:tabular-nums}
  .ministat .lbl{font-size:12px;color:var(--tx-2);margin-top:2px}
  .ministat .tag{margin-top:8px;display:inline-block;font-size:11px;color:var(--alert);box-shadow:var(--inset);border-radius:var(--r-sm);padding:2px 8px}
  .samplenote{font-size:12px;color:var(--tx-3);padding:10px 4px 0}

  .closer{padding:0 0 88px;text-align:center}

  /* Landing sections. Copy here is the gated deck at
     artifacts/wireframes-app/copy/SurveyRocket.md, word for word.
     Do not edit copy here without re-gating that deck. */
  .lp{padding:76px 0;border-top:1px solid var(--line)}
  .lp-head{max-width:660px;margin:0 0 40px}
  .lp-head.mid{margin:0 auto 44px;text-align:center}
  .lp h2{font-size:clamp(24px,2.9vw,32px);line-height:1.22;letter-spacing:-.01em;margin:0 0 14px;text-wrap:balance}
  .lp-head p{color:var(--tx-2);font-size:15.5px;line-height:1.7;margin:0 0 10px;max-width:60ch}
  .lp-head.mid p{margin-left:auto;margin-right:auto}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
  .split.flip .shot{order:-1}
  @media (max-width:880px){.split{grid-template-columns:1fr;gap:28px}.split.flip .shot{order:0}}
  .split p{color:var(--tx-2);font-size:15.5px;line-height:1.7;margin:0 0 12px}
  .shot{aspect-ratio:4/3;margin:0;background:var(--tile);box-shadow:var(--inset);border-radius:var(--r-lg);
        display:flex;align-items:center;justify-content:center;color:var(--tx-2);font-size:12px;
        letter-spacing:.08em;text-transform:uppercase;text-align:center;padding:20px}
  .twocol{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media (max-width:820px){.twocol{grid-template-columns:1fr}}
  .lpcard{background:var(--card);box-shadow:var(--inset);border-radius:var(--r-lg);padding:26px 24px}
  .lpcard h3{font-size:16px;margin:0 0 8px}
  .lpcard p{color:var(--tx-2);font-size:14px;line-height:1.65;margin:0}
  .quote{border-left:2px solid var(--green);padding:2px 0 2px 18px;margin:26px 0 0}
  .quote p{color:var(--tx);font-size:15.5px;line-height:1.6;margin:0 0 8px;font-style:italic}
  .quote .who{color:var(--tx-3);font-size:12.5px}
  .quote .who b{color:var(--tx-2);font-weight:500}
  .ticks{list-style:none;margin:18px 0 0;padding:0;display:flex;flex-direction:column;gap:9px}
  .ticks li{color:var(--tx-2);font-size:14.5px;padding-left:22px;position:relative}
  .ticks li::before{content:"";position:absolute;left:0;top:7px;width:8px;height:8px;border-radius:2px;background:var(--green)}
  .faq{max-width:760px;margin:0 auto}
  .qa{border-top:1px solid var(--line);padding:22px 0}
  .qa:last-child{border-bottom:1px solid var(--line)}
  .qa h3{font-size:16px;margin:0 0 8px}
  .qa p{color:var(--tx-2);font-size:14.5px;line-height:1.7;margin:0}
  .band{background:var(--card);box-shadow:var(--inset);border-radius:var(--r-lg);padding:52px 36px;text-align:center}
  .band h2{margin-bottom:12px}
  .band p{color:var(--tx-2);font-size:15.5px;line-height:1.7;margin:0 auto 26px;max-width:52ch}
  .band .ctas{justify-content:center}
  .band .note{margin-top:16px}

  /* Keyboard focus. Five interactive elements showed nothing at all when
     tabbed to, so a keyboard user could not tell where they were. :focus-visible
     rather than :focus, so a mouse click never draws a ring. */
  a:focus-visible, button:focus-visible, input:focus-visible, .opt:focus-visible{
    outline:2px solid var(--green); outline-offset:3px; border-radius:var(--r-sm)}
  .chat-input input:focus-visible{outline-offset:0}

  /* Answer chips were 29px tall. They are the main thing a thumb hits on a
     phone, and 29px is well under the touch-target floor. */
  .opt{min-height:40px}
  .chat-input input,.chat-input .send{min-height:40px}

  /* Screens and bubbles arrive rather than appearing, the way
     reputationrocket.ai does it. The global prefers-reduced-motion rule in
     styles-shared.css already switches all of this off for anyone who asks. */
  @keyframes srStageIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .demo-stage,#welcome{animation:srStageIn .34s ease both}
  @keyframes srBubbleIn{from{opacity:0;transform:translateY(6px) scale(.985)}to{opacity:1;transform:none}}
  .bub,.opts{animation:srBubbleIn .26s ease both}

  /* A skip link, because the tracker and the chat sit between the top of the
     page and anything a keyboard user wants to reach. */
  .skip-link{position:absolute;left:-9999px;top:8px;z-index:60;background:var(--card);
             color:var(--tx);padding:10px 16px;border-radius:var(--r-md);box-shadow:var(--inset)}
  .skip-link:focus{left:16px}
  .closer h2{font-size:24px;margin-bottom:16px}

  /* Step 2 and step 3 are separate screens now, each one centred column,
     rather than a chat squeezed beside a dashboard nobody could read yet. */
  .demo-stage{padding:0 0 64px}
  .stage-chat{max-width:560px;margin:0 auto;text-align:center}
  .stage-chat .chat-frame{text-align:left}
  .stage-dash{max-width:660px;margin:0 auto;text-align:center}
  .stage-dash .dash{text-align:left}
  #log{min-height:320px;max-height:54vh}
  .dash-top{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:16px 20px;border-bottom:1px solid var(--line)}
  .dash-top h3{font-size:15px}
  .dash .tiles{grid-template-columns:1fr 1fr;padding:16px 20px}
  .dash .chart{margin:0 20px 16px}
  .dash-note{padding:0 20px 18px;font-size:12px;color:var(--tx-3)}
  .dash-cta{padding:0 20px 20px;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
  .dash-review p{padding:0 20px;margin:0 0 12px;font-size:14px;color:var(--tx)}
  .dash-lock{padding:36px 20px;text-align:center;color:var(--tx-3);font-size:13.5px}

  /* Step tracker, the reputationrocket.ai shape adapted to Survey Rocket.
     Namespaced .sr-steps because .steps is already the landing page's
     "how it works" section, whose padding:24px 0 72px was silently adding 96px
     of dead air under this bar. */
  .sr-steps{display:flex;align-items:flex-start;justify-content:center;gap:0;
            max-width:720px;margin:42px auto 56px;flex-wrap:nowrap;overflow-x:auto}
  .sr-steps .step{display:flex;align-items:flex-start;flex:1 1 0;min-width:0}
  .sr-steps .step:last-child{flex:0 0 auto}
  .sr-steps .body{display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center;width:104px;flex:0 0 104px}
  .sr-steps .dot{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;
                 background:var(--tile);box-shadow:var(--inset);color:var(--tx-2);font-size:14px;font-weight:600;transition:.25s}
  .sr-steps .step.on .dot{background:var(--green);color:#04120c;box-shadow:none}
  .sr-steps .step.done .dot{background:transparent;box-shadow:var(--inset);color:var(--green)}
  .sr-steps .idx{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--tx-2)}
  .sr-steps .nm{font-size:13px;color:var(--tx-2);font-weight:500}
  .sr-steps .step.on .nm{color:var(--tx);font-weight:600}
  .sr-steps .pill{font-size:10.5px;padding:2px 8px;border-radius:999px;background:var(--tile);color:var(--tx-2);box-shadow:var(--inset)}
  .sr-steps .step.on .pill{background:rgba(0,212,146,.14);color:var(--green);box-shadow:none}
  .sr-steps .step.done .pill{color:var(--green)}
  .sr-steps .line{flex:1 1 auto;height:2px;background:var(--line);margin-top:18px;min-width:12px;border-radius:2px}
  /* Only a finished step fills the line after it. Filling the current step's
     trailing line implies the next one is reached, which it is not. */
  .sr-steps .step.done .line{background:var(--green)}
  @media (max-width:760px){ .sr-steps .body{width:80px;flex-basis:80px} .sr-steps .nm{font-size:11.5px} }


  /* Step 1. Spacing carries the grouping: a heading and its subtitle are one
     unit and sit close, the blocks between them get real air. A single uniform
     gap made every element look equally related to every other one, which is
     what read as cluttered even though nothing was actually crowded. */
  .welcome{max-width:560px;margin:0 auto;text-align:center}
  .lede{margin:0 0 40px}
  .lede h2{font-size:31px;line-height:1.25;letter-spacing:-.01em;text-wrap:balance;margin:0 0 14px}
  .lede .sub{color:var(--tx-2);font-size:15px;line-height:1.65;margin:0 auto;max-width:460px;text-wrap:pretty}
  .welcome .video{width:100%;aspect-ratio:16/9;max-height:250px;margin:0 0 32px;background:var(--tile);
                  box-shadow:var(--inset);border-radius:var(--r-lg);display:flex;align-items:center;
                  justify-content:center;color:var(--tx-2);font-size:13px;gap:10px;cursor:pointer}
  .welcome .video .play{width:46px;height:46px;border-radius:50%;background:var(--card);box-shadow:var(--inset);
                        display:flex;align-items:center;justify-content:center;color:var(--tx-2);font-size:15px}
  .heads{background:var(--card);box-shadow:var(--inset);border-radius:var(--r-lg);padding:18px 22px;margin:0 0 36px;text-align:center}
  .heads b{color:var(--tx)}
  .heads p{color:var(--tx-2);font-size:13.5px;margin:0;line-height:1.7}
  .welcome .go{display:flex;flex-direction:column;align-items:center;gap:14px}
  .micro{color:var(--tx-2);font-size:12.5px;margin:0}

  /* On a phone the same content has to clear a much shorter fold, and Begin is
     the whole point of the screen. Tighten the two things that cost the most
     height: the video placeholder and the gaps. */
  /* The constraint here is viewport HEIGHT, not width: a 1280x800 laptop is
     wide and short. Give tall screens the full breathing room and claw a
     little back only where the fold actually bites, so the button stays
     reachable without cramping every screen to suit the shortest one. */
  @media (max-height:880px){
    /* Short screens: the log is the only thing here that can give, and the
       input row has to stay reachable for typed answers. */
    #log{min-height:250px;max-height:44vh}
    .sr-steps{margin:26px auto 34px}
    .lede{margin-bottom:26px}
    .lede h2{font-size:27px;margin-bottom:11px}
    .welcome .video{max-height:170px;margin-bottom:22px}
    .heads{padding:14px 20px;margin-bottom:24px}
  }

  /* Phones are narrow AND short, so this sits after the height query and must
     not undo it. Only type size and padding change here; the vertical rhythm
     is whatever the height query already decided. */
  @media (max-width:560px){
    .sr-steps{margin:22px auto 30px}
    .lede h2{font-size:25px;margin-bottom:10px}
    .lede .sub{font-size:14px;line-height:1.6}
    .lede{margin-bottom:24px}
    .welcome .video{max-height:150px;margin-bottom:20px}
    .heads{padding:14px 16px;margin-bottom:22px}
    .heads p{font-size:12.5px}
    .micro{font-size:11.5px}
  }


</style>
</head>
<body class="lp-on">
<a class="skip-link" href={demo}>Skip to the demo</a>
<section class="view active" id="view-landing">

  <header class="lp-nav">
    <a class="lp-brand" href="/">
      <img src="/assets/landing/logo-mark.svg" width="48" height="55" alt="">
      <span><b>Survey</b> <i>Rocket</i></span>
    </a>
    <div class="lp-nav-actions">
      <a class="lp-btn solid" href={demo}>Try the live demo</a>
    </div>
  </header>

  <section class="lp-hero" data-hero-builder>
    <div class="lp-ripple" data-water-ripple aria-hidden="true">
      <canvas></canvas>
    </div>
    <div class="lp-hero-inner">
      <div>
        <h1 class="lp-reveal" data-delay="0">Turn customer surveys into <span class="em">stats you can publish</span></h1>
        <p class="lead lp-reveal" data-delay="520">Scan your pages for proof gaps, send a short survey from HubSpot, and let an AI chat turn customer answers into website citations.</p>
      </div>
      <div>
        <div class="lp-ctas">
          <a class="lp-btn solid lp-reveal" href={demo} data-delay="1040">Try the live demo</a>
          <a class="lp-btn glass lp-reveal" href="https://www.lean-labs.com" target="_blank" rel="noopener" data-delay="1280">Talk with our team</a>
        </div>
        <p class="lp-note lp-reveal" data-delay="1680"><img src="/assets/landing/icon-clock.svg" width="16" height="16" alt="">No sign-up. The demo takes about two minutes.</p>
      </div>
      <div class="lp-video lp-reveal fade" data-delay="2160" id="lpVideo">
        <img class="lp-video-thumb" src="/assets/images/7c248b618a126294316f6a.gif" width="736" height="379" alt="">
        <video class="lp-video-el" id="lpWelcomeVideo" playsinline preload="metadata" poster="/assets/images/7c248b618a126294316f6a.gif">
          <source src="/assets/videos/Reputation%20Rocket%20Intro.mp4" type="video/mp4">
        </video>
        <button type="button" class="lp-play" id="lpVideoPlay" aria-label="Play intro video">
          <img src="/assets/landing/icon-play.svg" width="19" height="19" alt="">
        </button>
      </div>
    </div>
  </section>

  <section class="lp-cite">
    <div class="lp-inner lp-cite-grid">
      <h2>Give AI <span class="em">authoritative results</span> to cite</h2>
      <p class="intro">Buyers ask ChatGPT and Gemini who to buy from, and assistants answer with evidence. A published stat gives them something to quote.</p>
      <div class="lp-cite-cards">
        <div class="lp-cite-card">
          <img class="lp-cite-icon" src="/assets/landing/icon-sparkle.svg" width="56" height="56" alt="">
          <h3>AI recommends companies with evidence</h3>
          <p>Ask an assistant who is best in your category and it reaches for numbers and cited results. Publish outcomes and it has something to repeat.</p>
        </div>
        <div class="lp-cite-card">
          <img class="lp-cite-icon" src="/assets/landing/icon-number.svg" width="56" height="56" alt="">
          <h3>Prospects ask for numbers, too</h3>
          <p>On the sales call, someone asks what results your customers get. One anecdote is a weaker answer than an average across all of them.</p>
        </div>
      </div>
      <p class="lp-cite-close">Survey your customers and both audiences get <span class="em">the same answer, a number backed by your whole base</span>.</p>
    </div>
  </section>

  <section class="lp-light">
    <div class="lp-inner">
      <div class="lp-gaps-top">
        <div class="lp-gaps-copy">
          <h2>Find the proof gaps on your website</h2>
          <p>Point Survey Rocket at a page and it flags the claims with no evidence behind them. Each gap comes back with a drafted survey that fills it.</p>
          <p>Or type the stat you want, and the questions that produce it arrive as a draft for your review.</p>
        </div>
        <blockquote class="lp-quote">
          <p>&ldquo;It starts with the data point we want to achieve, then the survey questions that would help us achieve it.&rdquo;</p>
          <div class="lp-who">
            <img src="/assets/landing/kevin-avatar.png" width="48" height="48" alt="">
            <div><b>Kevin Barber</b><span>Head of AI Growth, Lean Labs</span></div>
          </div>
        </blockquote>
      </div>
      <div class="lp-shot ph">Product screen &middot; gap scan</div>
    </div>
  </section>

  <section class="lp-steps">
    <div class="lp-inner">
      <h2>Launch a survey in <span class="em">three steps</span></h2>
      <div class="lp-stepgrid">
        <article class="lp-step lp-reveal" data-delay="0"><div class="n">01</div><div><h3>Send the invite from HubSpot</h3><p>Enroll customers in a short email series. Reminders stop the moment someone answers.</p></div></article>
        <article class="lp-step lp-reveal" data-delay="180"><div class="n">02</div><div><h3>Ask the questions as a chat</h3><p>Questions arrive one at a time, and most answers are a single tap. It reads like a conversation and takes minutes.</p></div></article>
        <article class="lp-step lp-reveal" data-delay="360"><div class="n">03</div><div><h3>Publish the running averages</h3><p>Watch each response update your running average, then put the stat on your website.</p></div></article>
      </div>
    </div>
  </section>
  <div class="lp-fade" aria-hidden="true"></div>

  <section class="lp-features" id="lp-features">
    <div class="lp-feat-pin">
      <div class="lp-feat-col">
        <article class="lp-feat is-on" data-feat="0">
          <div class="lp-feat-copy">
            <div>
              <h2>Turn your questions into a chat customers finish</h2>
              <p class="body">Write them in a plain editor and watch the preview build as you type. Your customers see exactly what you wrote.</p>
              <ul class="lp-ticks">
                <li><img src="/assets/landing/icon-check.svg" width="14" height="14" alt="">Multiple choice, one tap</li>
                <li><img src="/assets/landing/icon-check.svg" width="14" height="14" alt="">Multiple select for pick-all-that-apply</li>
                <li><img src="/assets/landing/icon-check.svg" width="14" height="14" alt="">Numbers, checked before they count</li>
