---
import Base from "../../../../layouts/Base.astro";
import AppShell from "../../../../components/AppShell.astro";
import Results from "../../../../components/Results";
import ViewTip from "../../../../components/ViewTip";
import { requireClientAccess } from "../../../../lib/access";
import { db } from "../../../../lib/db";
import { surveys } from "../../../../lib/schema";
import { desc } from "drizzle-orm";
import { liveSurveys } from "../../../../lib/survey-scope";

const slug = Astro.params.client!;
const id = Astro.params.id!;
const access = await requireClientAccess(Astro.locals.user, Astro.locals.isSuperadmin, slug);
if (!access.ok) {
  if (access.status === 401) return Astro.redirect("/login");
  return Astro.redirect("/app");
}
const list = await db.select().from(surveys).where(liveSurveys(access.client.id)).orderBy(desc(surveys.updatedAt));
const sv = list.find((s) => s.id === id);
if (!sv) return Astro.redirect(`/app/${slug}/results`);
---
<Base title={`${sv.name} · Results`}>
  <AppShell slug={slug} clientName={access.client.name} current="results" isSuperadmin={Astro.locals.isSuperadmin} email={Astro.locals.user?.email}>
    <div class="wrap">
      <div class="pagehead" id="resultsHead">
        <h1>Results</h1>
        <p>Live results for every survey, newest answers first. Progress updates as people answer.</p>
      </div>
      <ViewTip client:load />
      <Results
        client:load
        clientSlug={slug}
        surveyId={id}
        surveys={list.map((s) => ({ id: s.id, name: s.name }))}
      />
    </div>
  </AppShell>
</Base>
