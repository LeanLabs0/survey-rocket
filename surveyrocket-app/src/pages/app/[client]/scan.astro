---
import Base from "../../../layouts/Base.astro";
import AppShell from "../../../components/AppShell.astro";
import ScanForm from "../../../components/ScanForm";
import ViewTip from "../../../components/ViewTip";
import { requireClientAccess } from "../../../lib/access";

const slug = Astro.params.client!;
const access = await requireClientAccess(Astro.locals.user, Astro.locals.isSuperadmin, slug);
if (!access.ok) {
  if (access.status === 401) return Astro.redirect("/login");
  return Astro.redirect("/app");
}
---
<Base title="Scan a page · Survey Rocket">
  <AppShell slug={slug} clientName={access.client.name} current="scan" isSuperadmin={Astro.locals.isSuperadmin} email={Astro.locals.user?.email}>
    <div class="wrap">
      <div class="pagehead">
        <h1>Scan a page</h1>
        <p>The scan reads one page and drafts a survey for each claim on it with no proof behind it. Name a stat if you already know the one you want. Drafts land in the editor, and nothing goes live without your approval.</p>
      </div>
      <ViewTip client:load />
      <ScanForm client:load clientSlug={slug} />
    </div>
  </AppShell>
</Base>
