---
import Base from "../layouts/Base.astro";
import DemoResultsChart from "../components/DemoResultsChart";
import "../styles/styles-survey-intro.css";
import "../styles/styles-demo.css";
import { resolveSurveyBrand } from "../lib/brand";

const brand = resolveSurveyBrand(null, { clientName: "Lean Labs", surveyName: "Client outcomes" });
---
<Base title="Survey Rocket demo" bodyClass="rs-intro-page sr-demo">
  <Fragment slot="head">
    <script is:inline>
      document.documentElement.setAttribute("data-theme", "dark");
      document.documentElement.classList.add("dark");
    </script>
  </Fragment>

  <div class="sr-demo-banner" id="sr-demo-banner">
    <span class="sr-demo-banner-badge">Demo</span>
    <span class="sr-demo-banner-text">You’re exploring a sample run with a fictional company. Nothing is sent or posted.</span>
    <div class="sr-demo-banner-actions">
      <button type="button" class="sr-demo-banner-btn" id="sr-demo-replay">Replay tour</button>
      <a href="/" class="sr-demo-banner-btn sr-demo-banner-btn--ghost">Exit demo</a>
    </div>
  </div>

  <div class="rs-page sr-demo-page" style={brand.cssVars} data-bot-avatar="icon">
    <div class="rs-glow" aria-hidden="true"></div>
    <div class="rs-main">
      <a class="rs-intro-brand" href="/">
        <img src={brand.markUrl} width="48" height="55" alt="">
        <span><b>Survey</b> <i>Rocket</i></span>
      </a>

      <div class="rs-steps" id="steps">
        <div class="rs-step on" data-step="0">
          <span class="dot">
            <img class="ico" src="/assets/survey-intro/icon-hand.svg" width="20" height="20" alt="">
            <img class="check" src="/assets/survey-intro/icon-check.svg" width="36" height="36" alt="">
          </span>
          <span class="idx">Step 1</span>
          <span class="nm">Welcome</span>
          <span class="pill">In Progress</span>
        </div>
        <span class="rs-step-line partial" aria-hidden="true"></span>
        <div class="rs-step" data-step="1">
          <span class="dot">
            <img class="ico" src="/assets/survey-intro/icon-chat.svg" width="20" height="20" alt="">
            <img class="check" src="/assets/survey-intro/icon-check.svg" width="36" height="36" alt="">
          </span>
          <span class="idx">Step 2</span>
          <span class="nm">Quick Chat</span>
          <span class="pill">Pending</span>
        </div>
        <span class="rs-step-line" aria-hidden="true"></span>
        <div class="rs-step" data-step="2">
          <span class="dot">
            <img class="ico" src="/assets/survey-intro/icon-dash.svg" width="20" height="20" alt="">
            <img class="check" src="/assets/survey-intro/icon-check.svg" width="36" height="36" alt="">
          </span>
          <span class="idx">Step 3</span>
          <span class="nm">Your Dashboard</span>
          <span class="pill">Pending</span>
        </div>
      </div>

      <div class="rs-welcome" id="welcome">
        <h1>Ready to <span class="em">share your results</span> with Lean Labs?</h1>
        <p class="rs-sub">We’d love to capture what actually changed, so you and future clients can get a better experience with us.</p>
        <div class="rs-video" id="rsVideo">
          <img class="rs-video-thumb" src="/assets/images/7c248b618a126294316f6a.gif" width="736" height="379" alt="">
          <video class="rs-video-el" id="rsWelcomeVideo" playsinline preload="metadata" poster="/assets/images/7c248b618a126294316f6a.gif">
            <source src="/assets/videos/Reputation%20Rocket%20Intro.mp4" type="video/mp4">
          </video>
          <button type="button" class="rs-play" id="rsVideoPlay" aria-label="Play welcome video">
            <img src="/assets/survey-intro/icon-play.svg" width="19" height="19" alt="">
          </button>
        </div>
        <div class="rs-heads">
          <span class="rs-heads-icon" aria-hidden="true"><img src="/assets/survey-intro/icon-smile.svg" width="18" height="18" alt=""></span>
          <p><b>Heads up:</b> you are playing a Lean Labs client. Most answers take a single tap, and nothing you type is stored.</p>
        </div>
        <button class="rs-begin" type="button" id="g-go">Begin <img src="/assets/survey-intro/icon-arrow.svg" width="16" height="16" alt=""></button>
        <p class="rs-micro"><img src="/assets/landing/icon-clock.svg" width="16" height="16" alt="">Takes about two minutes.</p>
      </div>

      <div class="rs-chat-wrap" id="chatWrap">
        <div class="rs-chat-lede">
          <h2>{brand.chatLede}</h2>
          <p>{brand.chatSub}</p>
        </div>
        <div class="chat-frame" id="frame">
          <div class="chat-head">
            <div>
              <b>{brand.chatTitle}</b>
              <small>{brand.poweredBy}</small>
            </div>
            <span class="chat-prog" id="prog"></span>
          </div>
          <div class="chat-log" id="log" aria-live="polite"></div>
          <div class="chat-input" id="chatInput">
            <input id="inp" type="text" autocomplete="off" placeholder="Tap an option above" aria-label="Your answer" disabled>
            <button class="send" id="sendBtn" disabled>Send</button>
            <button class="chat-restart" type="button" id="restartBtn">Restart</button>
          </div>
        </div>
      </div>

      <div class="sr-demo-dash" id="stageDash">
        <div class="rs-chat-lede">
          <h2>This is what you would see in your dashboard</h2>
          <p>Your answer just joined the average. When enough people have answered, the number at the top is the one that goes on your website.</p>
        </div>
        <div class="sr-demo-box" id="dashbox">
          <div class="sr-demo-box-top">
            <h3>Lean Labs, client results</h3>
            <span class="chip" id="respcount">128 responses</span>
            <span class="chip gold">Sample data</span>
          </div>
          <div class="sr-demo-tiles">
            <div class="sr-demo-tile">
              <div class="lbl">Share of clients whose conversion rate went up after working with Lean Labs</div>
              <div class="num" id="t-outcome">78%</div>
              <div class="src">Everyone who picked any increase</div>
            </div>
            <div class="sr-demo-tile">
              <div class="lbl">Net Promoter Score</div>
              <div class="num" id="t-nps">52</div>
              <div class="src">% promoters minus % detractors</div>
            </div>
          </div>
          <div class="sr-demo-chart-wrap">
            <div class="sr-demo-chart">
              <h4>How conversion rate changed</h4>
              <p class="sub">Per answer</p>
              <DemoResultsChart client:load />
            </div>
            <p class="sr-demo-note" id="joinnote" hidden>Your answer just moved these numbers. That is the whole product.</p>
          </div>
          <div class="sr-demo-review" id="dashReview">
            <p><em>Thanks for your answers.</em> Would you be open to leaving us a review?</p>
            <div class="btns">
              <button class="sr-demo-review-btn" type="button" disabled>Leave us a review</button>
              <button class="sr-demo-ghost" type="button" id="dashRestart">Start over</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <footer class="rs-foot">
      <div class="rs-foot-brand">
        <img class="ll" src="/assets/images/ll-tools.svg" width="122" height="30" alt="Lean Labs Tools">
      </div>
      <div class="rs-copy">
        <span>&copy; 2026 Survey Rocket.ai. Demo data is fictional and resets on reload.</span>
      </div>
    </footer>
  </div>

  <script is:inline>window.SR_JUDGE_ENABLED = true;</script>
  <script is:inline src="/js/engine.js"></script>
  <script is:inline src="/js/demo.js"></script>
  <script is:inline>
    (function(){
      var box = document.getElementById("rsVideo");
      var vid = document.getElementById("rsWelcomeVideo");
      if (!box || !vid) return;
      function start(){
        if (box.classList.contains("is-playing")) return;
        box.classList.add("is-playing");
        vid.setAttribute("controls", "");
        var play = vid.play();
        if (play && play.catch) play.catch(function(){});
      }
      box.addEventListener("click", function(e){
        if (box.classList.contains("is-playing")) return;
        e.preventDefault();
        start();
      });
    })();
  </script>
</Base>
